        <p class="muted">{{ study.data.cardSummary }}</p>
        <p class="card__result">{{ study.data.headlineResult }} &middot; {{ study.data.headlineLabel }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section">
