{
  "extends": ["html-validate:recommended"],
  "rules": {
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "attribute-boolean-style": "off",
    "no-inline-style": "off",
    "require-sri": "off",
    "long-title": ["error", { "maxlength": 70 }]
  },
  "elements": [
    "html5",
    {
      "body": {
        "attributes": {
          "hx-boost": { "enum": ["true", "false"] },
          "hx-target": {},
          "hx-select": {},
          "hx-swap": {}
        }
      }
    }
  ]
}
