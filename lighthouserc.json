{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/about/index.html",
        "http://localhost/case-studies/index.html",
        "http://localhost/case-studies/enterprise-migration/index.html",
        "http://localhost/capabilities/index.html",
        "http://localhost/approach/index.html",
        "http://localhost/ai-search/index.html",
        "http://localhost/technical-notes/index.html",
        "http://localhost/contact/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:performance": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "csp-xss": "off",
        "unsized-images": "error",
        "meta-description": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "canonical": "error",
        "crawlable-anchors": "error",
        "is-crawlable": "error",
        "link-text": "error",
        "robots-txt": "off",
        "color-contrast": "error",
        "heading-order": "error",
        "uses-responsive-images": "warn",
        "modern-image-formats": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
